# multilingual-bert-command-model (training runs on Colab/Kaggle GPU; local is code+tests).
# The src/*.py CLIs are argparse-only — no env vars are read. The knobs below
# are the standard environment surface around training: HF auth/cache, device
# selection, and run overrides consumed as --flags (see config.example.yml).

# Hugging Face: base model google-bert/bert-base-multilingual-cased is public,
# token only needed for private repos, gated data, or pushing artifacts.
HF_TOKEN=
HF_HUB_CACHE=
HF_HUB_OFFLINE=

# Device selection. Training target is a T4-grade GPU; local runs stay CPU-only.
CUDA_VISIBLE_DEVICES=
TORCH_DEVICE=cpu

# Run overrides (translate to --flags, e.g. --epochs "$TRAIN_EPOCHS").
TRAIN_EPOCHS=5
TRAIN_SEED=42
TRAIN_VERSION=multilingual-intent-slot-v2
OUTPUT_DIR=output
DATA_DIR=data
